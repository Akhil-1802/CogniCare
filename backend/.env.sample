# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# JWT (use 32+ random chars; generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_64_hex_char_jwt_secret
JWT_REFRESH_SECRET=your_64_hex_char_jwt_refresh_secret_different_from_above

# SMTP (Email Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# AI Assistant (fully dynamic via Mistral — just set the key)
CHAT_RETENTION_DAYS=30
CHAT_CLEANUP_ENABLED=false
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_TEMPERATURE=0.2
MISTRAL_MAX_TOKENS=800
MISTRAL_TIMEOUT=60
# Fast tiny model for tool-routing (keeps replies quick). Falls back to MISTRAL_MODEL if unavailable.
MISTRAL_PLANNER_MODEL=ministral-3b-latest
MISTRAL_PLANNER_MAX_TOKENS=200
CHROMA_DIR=./chroma_data

# Memory Scoring & Retention Configuration
MEMORY_IMPORTANCE_WEIGHT=0.30
MEMORY_CONFIDENCE_WEIGHT=0.25
MEMORY_USEFULNESS_WEIGHT=0.20
MEMORY_PERSISTENCE_WEIGHT=0.15
MEMORY_NOVELTY_WEIGHT=0.10

MEMORY_DISCARD_THRESHOLD=40
MEMORY_TEMPORARY_THRESHOLD=60
MEMORY_STANDARD_THRESHOLD=80

MEMORY_MIN_CONFIDENCE=0.70

MEMORY_TEMPORARY_RETENTION_DAYS=7
MEMORY_STANDARD_RETENTION_DAYS=30
MEMORY_LONG_TERM_RETENTION_DAYS=90

MEMORY_CLEANUP_ENABLED=false

# Auth cookies (local dev defaults work over http://localhost)
APP_ENV=development
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
