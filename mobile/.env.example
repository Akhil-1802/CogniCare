# CogniCare Mobile Environment Configuration

# Optional: Override the default backend base URL
# Android Emulator defaults to: http://10.0.2.2:8000
# iOS Simulator defaults to: http://localhost:8000
# Physical devices require your computer's local Wi-Fi IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
